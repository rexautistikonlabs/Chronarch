{
  "name": "rexmetrix-web",
  "private": true,
  "version": "0.0.1",
  "description": "RexMetrix: research software for hypothesis-led programmes. Fields, bridges, programmes, synthesis. Not a diagnostic. Not Foundation-endorsed. Not a public chain.",
