    "@react-three/postprocessing": "^3.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^1.0.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
